from math import sqrt
my_List=[]
num = int(input("Enter the number of elements in  List: "))
for  i in range(num):
    val=int(input("Enter the element:"))
    my_List.append(val)
print("The length of List 1 is: ",len(my_List))
print("List contents",my_List)
total = 0
for elem in my_List:
    total+=elem
mean = total/num
total = 0
for elem in my_List:
    total+=(elem-mean)*(elem-mean)
variance=total/num
stddev=sqrt(variance)
print("Mean:",mean)
print("Variance:",variance)
print("Standard Deviation:",stddev)